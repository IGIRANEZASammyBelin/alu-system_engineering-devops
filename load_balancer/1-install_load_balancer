#!/usr/bin/env bash
# Installs HAProxy and configures it to send traffic to web-01 and web-02 using roundrobin

apt-get -y update
apt-get -y install haproxy

# Let the init script start HAProxy
echo "ENABLED=1" >> /etc/default/haproxy

cat > /etc/haproxy/haproxy.cfg <<'EOF'
global
    log /dev/log local0
    maxconn 2048
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000
    timeout client  50000
    timeout server  50000

frontend http_front
    bind *:80
    default_backend http_back

backend http_back
    balance roundrobin
    server 7288-web-01 18.133.245.231:80 check
    server 7288-web-02 18.130.235.146:80 check
EOF

service haproxy restart
